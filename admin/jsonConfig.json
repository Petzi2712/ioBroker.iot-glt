{
  "type": "panel",
  "items": {
    "server": {
      "type": "panel",
      "label": "Webserver",
      "items": {
        "bind": { "type": "ip", "label": "Bind-Adresse", "newLine": true },
        "port": { "type": "number", "label": "Port", "min": 1024, "max": 65535 },
        "sessionHours": { "type": "number", "label": "Sitzungsdauer (Stunden)", "min": 1, "max": 168 },
        "defaultReadOnly": { "type": "checkbox", "label": "Unangemeldete Besucher dürfen lesen" }
      }
    },
    "services": {
      "type": "panel",
      "label": "Dienste",
      "items": {
        "historyInstance": { "type": "instance", "adapter": "history", "label": "History-Instanz", "allowDeactivate": true },
        "emailInstance": { "type": "instance", "adapter": "email", "label": "E-Mail-Instanz", "allowDeactivate": true },
        "co2Factor": { "type": "number", "label": "Standard CO₂-Faktor (kg/kWh)", "min": 0, "step": 0.001 },
        "currency": { "type": "text", "label": "Währung" }
      }
    }
  }
}
